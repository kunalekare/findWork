# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# MAPS_API_KEY: Google Maps SDK for Android API Key
# Restricted to package: in.skillbridge.app and SHA-1 fingerprint
MAPS_API_KEY=PLACEHOLDER_MAPS_API_KEY

# SERVER_GOOGLE_ROUTES_KEY: Restricted to Routes API & Geocoding API by server IP
SERVER_GOOGLE_ROUTES_KEY=PLACEHOLDER_ROUTES_KEY
